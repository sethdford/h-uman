#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	cmake -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DHU_ENABLE_ALL_CHANNELS=ON \
		-DHU_ENABLE_LTO=ON

override_dh_auto_build:
	cmake --build build -j$$(nproc)

override_dh_auto_install:
	DESTDIR=debian/human cmake --install build

override_dh_auto_test:
	# Run from the source root (NOT `cd build`) so tests that open
	# repo-relative fixture files — e.g. test_homebrew_formula.c opening
	# Formula/human.rb and scripts/install/human-daemon.plist.template —
	# resolve correctly. This matches the canonical invocation used
	# everywhere else in CI (`./build/human_tests` from the repo root).
	./build/human_tests
