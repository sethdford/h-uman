#!/bin/sh
# pre-commit: auto-format C files, format check, design token lint.
# Activate: git config core.hooksPath .githooks

CLANG_FMT="clang-format"
if ! command -v "$CLANG_FMT" >/dev/null 2>&1; then
    for p in /opt/homebrew/opt/llvm/bin/clang-format /usr/local/opt/llvm/bin/clang-format; do
        if [ -x "$p" ]; then CLANG_FMT="$p"; break; fi
    done
fi

if [ -d "src" ] && [ -f "CMakeLists.txt" ]; then
    staged_ch=$(git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h')
    if [ -n "$staged_ch" ]; then
        echo "$staged_ch" | while IFS= read -r f; do
            if grep -qn '	' "$f" 2>/dev/null; then
                echo "Warning: tabs found in $f (project uses spaces)"
            fi
        done
        echo "$staged_ch" | xargs "$CLANG_FMT" -i 2>/dev/null
        echo "$staged_ch" | xargs git add
        if ! echo "$staged_ch" | xargs "$CLANG_FMT" --dry-run -Werror 2>/dev/null; then
            echo "clang-format failed even after auto-format. Check .clang-format config."
            exit 1
        fi
    fi
fi

# Check for declared-but-undefined symbols in staged headers
if [ -d "build" ] && [ -f "build/libhuman_core.a" ]; then
    staged_h=$(git diff --cached --name-only --diff-filter=ACM -- 'include/human/*.h' 'include/human/**/*.h')
    if [ -n "$staged_h" ]; then
        UNDEFS=$(nm -u build/libhuman_core.a 2>/dev/null | grep ' U _sc_' | sort -u || true)
        if [ -n "$UNDEFS" ]; then
            echo "Warning: possibly undefined hu_* symbols in library:"
            echo "$UNDEFS" | head -10
        fi
    fi
fi

# Check design token drift when token sources change
staged_tokens=$(git diff --cached --name-only --diff-filter=ACM -- 'design-tokens/*.tokens.json' 'design-tokens/build.ts')
if [ -n "$staged_tokens" ]; then
  if [ -x "design-tokens/check-drift.sh" ]; then
    echo "Checking design token drift..."
    bash design-tokens/check-drift.sh
    if [ $? -ne 0 ]; then
      echo "Token drift detected. Run: cd design-tokens && npm run build"
      exit 1
    fi
  fi
fi

# Regenerate website assets when SVG sources or generate script change
staged_assets=$(git diff --cached --name-only --diff-filter=ACM -- 'website/public/human.svg' 'website/public/og-image.svg' 'website/scripts/generate-assets.mjs')
if [ -n "$staged_assets" ]; then
  if command -v node >/dev/null 2>&1 && [ -f "website/scripts/generate-assets.mjs" ]; then
    echo "Regenerating website favicon/OG assets..."
    (cd website && node scripts/generate-assets.mjs)
    git add website/public/favicon-32.png website/public/apple-touch-icon.png website/public/og-image.png 2>/dev/null
  fi
fi

# Lint for raw hex colors in staged CSS/TS/Astro files
if [ -x "scripts/lint-raw-colors.sh" ]; then
    staged_style=$(git diff --cached --name-only --diff-filter=ACM -- '*.css' '*.ts' '*.tsx' '*.astro' | grep -v 'tokens\.' | grep -v 'design-tokens/' || true)
    if [ -n "$staged_style" ]; then
        ./scripts/lint-raw-colors.sh
        if [ $? -ne 0 ]; then
            echo "Raw hex color lint failed. Use --hu-* or --hu-web-* design tokens instead."
            exit 1
        fi
    fi
fi

# Lint for raw values (rgba, durations, breakpoints) in staged UI TS files
staged_ui_ts=$(git diff --cached --name-only --diff-filter=ACM -- 'ui/src/**/*.ts' | grep -v '.test.' | grep -v 'demo-gateway' || true)
if [ -n "$staged_ui_ts" ] && [ -x "ui/scripts/lint-raw-values.sh" ]; then
    echo "Checking design token usage in staged UI files..."
    # Strip ui/ prefix since lint script runs from ui/ dir
    stripped=$(echo "$staged_ui_ts" | sed 's|^ui/||')
    (cd ui && bash scripts/lint-raw-values.sh $stripped)
    if [ $? -ne 0 ]; then
        echo "Token lint failed. Use --hu-* design tokens instead of raw hex/rgba/durations."
        exit 1
    fi
fi

# Sprint 11 / US-11.6 / D1: refuse to commit real YNTP holdout data into the
# public repo. The synthetic-5 fixture is fine; the redacted sample-10 is
# fine; the real 30-row holdout MUST stay in ~/.human/private/ on Seth's
# machine only. See sprints/sprint-11/decisions.md D1.
if [ -x "scripts/check_no_yntp_holdout_staged.sh" ]; then
    bash scripts/check_no_yntp_holdout_staged.sh
    if [ $? -ne 0 ]; then
        echo "YNTP holdout guard failed (real chat-derived holdout must not land in repo)."
        exit 1
    fi
fi

# Check that staged test files reference at least one production symbol (Sprint 4 US-10)
if [ -x "scripts/check-test-references.sh" ]; then
    if ! scripts/check-test-references.sh; then
        echo "Test-references check failed. See output above."
        echo "Add '// @covers-none' to suppress for intentional standalone tests."
        exit 1
    fi
fi

# Test/source gate-symmetry check — added after PR #113 hit the same
# systemic failure 6+ times across 13 rounds. Fires when a staged change
# touches CMakeLists.txt OR a tests/test_*.c file, since those are the
# moments where a gate-mismatch can be introduced. See
# .claude/rules/test-source-gate-symmetry.md for the failure pattern.
staged_gate_inputs=$(git diff --cached --name-only --diff-filter=ACM -- \
    'CMakeLists.txt' 'tests/test_*.c' 'tests/test_main.c')
if [ -n "$staged_gate_inputs" ] && [ -x "scripts/check-test-source-gate-symmetry.sh" ]; then
    if ! bash scripts/check-test-source-gate-symmetry.sh; then
        echo ""
        echo "Pre-commit blocked: test/source gate-symmetry violations."
        echo "See .claude/rules/test-source-gate-symmetry.md for the fix pattern."
        exit 1
    fi
fi

# tests-that-pin-bugs antipattern check — recurred 3 times in Sprint 49
# (US-C1.1, US-C1.2, US-C1.4) where an assertion was gated on whether
# the input-under-test exists, so the test silently PASSED when the
# input was missing. See .claude/rules/tests-that-pin-bugs.md +
# scripts/check-test-silent-pass.sh for the detector and opt-out.
if [ -x "scripts/check-test-silent-pass.sh" ]; then
    if ! scripts/check-test-silent-pass.sh; then
        echo ""
        echo "Pre-commit blocked: tests-that-pin-bugs antipattern."
        echo "See .claude/rules/tests-that-pin-bugs.md for the fix pattern."
        exit 1
    fi
fi

# Sprint 54 US-C3.9 — Doctor exit-code parity guard. Asserts that the
# HU_DOCTOR_EXIT_* constants in include/human/doctor.h match the
# exit-code table in docs/guides/doctor.md. Fires whenever either
# file is staged.
staged_doctor_inputs=$(git diff --cached --name-only --diff-filter=ACM -- \
    'include/human/doctor.h' 'docs/guides/doctor.md')
if [ -n "$staged_doctor_inputs" ] && [ -x "scripts/check-doctor-exit-codes-in-sync.sh" ]; then
    if ! bash scripts/check-doctor-exit-codes-in-sync.sh; then
        echo ""
        echo "Pre-commit blocked: doctor exit-code drift."
        echo "include/human/doctor.h constants must match docs/guides/doctor.md."
        echo "See sprints/sprint-54/designs/US-C3.9.md for the contract."
        exit 1
    fi
fi
