#!/bin/sh
# pre-push: run the full test suite before pushing.
# Activate: git config core.hooksPath .githooks
# Note: ASan and coverage are CI-only (too slow for local hooks).
#
# Set HU_FULL_PREPUSH=1 to also run UI typecheck/tests and website build.

JOBS=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || echo 4)
BUILD_DIR="build-check"

if [ -f "CMakeLists.txt" ]; then
    echo "Running human tests..."
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR" || exit 1
    # Configure with the portable feature set.
    #
    # This used to pass only -DHU_ENABLE_ALL_CHANNELS -DHU_ENABLE_CURL, which
    # left whole suites uncompiled: measured 12,617 tests versus 13,933 from a
    # fully-configured build. That was a 1,316-test (9.4%) blind spot in the
    # gate — those tests did not run before a push. It also fed
    # update-stats.sh, which at the time re-ran the first available build/,
    # build2/, build-check/ or build-release/ binary, so every push stamped an
    # undercounted test total across AGENTS.md, README.md and friends, and the
    # rewrite had to be discarded by hand. (The stamping side is fixed below:
    # the sync now receives the count parsed from THIS run's Results: line.)
    #
    # The flags below are the ones that add test coverage without adding an
    # external dependency: measured 13,827 tests, closing ~92% of that gap.
    # Deliberately NOT enabled, to keep this hook runnable on any dev machine:
    #   HU_ENABLE_ASAN               too slow for a local hook (CI-only, see header)
    #   HU_ENABLE_LIBSODIUM          needs a system library
    #   HU_ENABLE_INTEGRATION_TESTS  needs live services
    #   HU_ENABLE_IMESSAGE, _APPLE_INTELLIGENCE, _EMBEDDED_MODEL, _CARTESIA
    #                                platform- or asset-specific
    # A residual delta against a dev-preset build is therefore expected, as is
    # a delta whenever the local branch is behind main (different sources,
    # different test count) — update-stats.sh reports whatever this tree
    # builds, so treat its output as "this tree", not "the project".
    #
    # Configure unconditionally: the old `if [ ! -f CMakeCache.txt ]` guard
    # meant an existing build-check kept its original flags forever, so a
    # change here would never reach anyone who already had one. Re-running
    # cmake with unchanged arguments is a cheap no-op.
    cmake .. -DCMAKE_BUILD_TYPE=Debug \
        -DHU_ENABLE_ALL_CHANNELS=ON \
        -DHU_ENABLE_CURL=ON \
        -DHU_ENABLE_SQLITE=ON \
        -DHU_ENABLE_PERSONA=ON \
        -DHU_ENABLE_SKILLS=ON \
        -DHU_ENABLE_ML=ON \
        -DHU_ENABLE_LEARNING=ON \
        -DHU_ENABLE_RL_FULL=ON \
        -DHU_ENABLE_FEEDS=ON \
        -DHU_ENABLE_SYNTHETIC=ON \
        -DHU_ENABLE_CHANNEL_TESTS=ON >/dev/null 2>&1 || {
        echo "cmake configure failed. Fix before pushing."
        exit 1
    }
    cmake --build . -j"$JOBS" 2>&1 | tail -3
    if [ $? -ne 0 ]; then
        echo "Build failed. Fix before pushing."
        exit 1
    fi
    # Run from the repo root: a number of tests open fixtures by repo-relative
    # path (docs/, scripts/release/, .github/workflows/, Formula/). Running
    # ./human_tests from inside the build dir made those ~44 tests fail
    # spuriously (CWD couldn't resolve the relative paths).
    cd ..
    # Tee the run so its own "--- Results: N/N passed ---" line can be parsed
    # below: that N is the only test count this hook has verified, and it is
    # the one the stats sync must stamp. (POSIX sh has no pipefail, so the
    # suite's exit status is written to a side file.)
    results_log=$(mktemp "${TMPDIR:-/tmp}/human_tests.XXXXXX") || exit 1
    { "$BUILD_DIR/human_tests"; echo $? > "$results_log.rc"; } | tee "$results_log"
    tests_rc=$(cat "$results_log.rc" 2>/dev/null || echo 1)
    TEST_COUNT=$(sed -n 's|^--- Results: \([0-9][0-9]*\)/[0-9][0-9]* passed.*|\1|p' "$results_log" | head -1)
    rm -f "$results_log" "$results_log.rc"
    if [ "$tests_rc" -ne 0 ]; then
        echo "Tests failed. Fix before pushing."
        exit 1
    fi

    # Auto-sync stats across all docs (AGENTS.md, README.md, CONTRIBUTING.md, etc.)
    # Only sync from a tree that actually contains all of origin/main.
    #
    # update-stats.sh stamps THIS tree's measurements into AGENTS.md,
    # README.md, CONTRIBUTING.md, PROJECT_STATUS.md and CLAUDE.md. From a tree
    # that is behind main those numbers are wrong by construction — it counts
    # tests that main has since added — so the push dirtied five tracked docs
    # with a value that had to be thrown away by hand. On 2026-07-26 that hit
    # ten worktrees at once and was discarded six times in one session; the
    # stamped count wandered 12,617 / 13,107 / 13,827 / 13,860 / 13,876 purely
    # from which tree happened to push.
    #
    # When the tree IS current the sync is correct and still runs — that is
    # the case that produced the accurate 13,860 -> docs update. So this
    # narrows the sync to when it is right rather than disabling it.
    #
    # Skipping is always safe: stats are descriptive, and the next push from
    # an up-to-date tree re-syncs them.
    #
    # The count passed is the one parsed from THIS run above. Before
    # 2026-09-03 the sync re-ran whichever build*/human_tests sorted first —
    # a two-day-old build/ dev binary of a different tree state — and stamped
    # 13,995 while this hook had just measured 14,125 (third recorded
    # writer-vs-checker disagreement; see the top of this file). Likewise the
    # binary size: this hook only builds Debug, so it cannot vouch for any
    # release binary's age (a five-week-old build-release/ stamped ~2952 KB
    # the same day); --keep-binary-size leaves the committed value alone.
    # Rule: .claude/rules/no-number-without-a-measurement.md.
    if [ -x "scripts/update-stats.sh" ]; then
        behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo unknown)
        if [ "$behind" = "0" ] && [ -z "$TEST_COUNT" ]; then
            echo "WARN: could not parse a test count from this run's Results: line;"
            echo "  skipping stats sync rather than stamping a count from a stale binary."
        elif [ "$behind" = "0" ]; then
            echo "Syncing project stats (${TEST_COUNT} tests, measured by this run)..."
            if ! bash scripts/update-stats.sh --apply --test-count "$TEST_COUNT" --keep-binary-size 2>/dev/null; then
                echo "Warning: stats sync failed. Run 'scripts/update-stats.sh --apply --test-count ${TEST_COUNT} --keep-binary-size' manually."
            fi
        elif [ "$behind" = "unknown" ]; then
            echo "Skipping stats sync (cannot compare against origin/main)."
        else
            echo "Skipping stats sync: $behind commit(s) behind origin/main — this"
            echo "  tree's counts would not match main. Sync happens on a push from"
            echo "  an up-to-date tree, or run scripts/update-stats.sh --apply."
        fi
    fi

    # Optional: UI and website checks (set HU_FULL_PREPUSH=1 to enable)
    if [ "${HU_FULL_PREPUSH:-0}" = "1" ]; then
        if [ -f "ui/package.json" ]; then
            echo "Running UI checks..."
            (cd ui && npm run typecheck && npm test) || {
                echo "UI checks failed. Fix before pushing."
                exit 1
            }
        fi
        if [ -f "website/package.json" ]; then
            echo "Running website build..."
            (cd website && npm run build) || {
                echo "Website build failed. Fix before pushing."
                exit 1
            }
        fi
        if [ -x "design-tokens/check-drift.sh" ]; then
            echo "Checking design token drift..."
            bash design-tokens/check-drift.sh || {
                echo "Design token drift detected. Run: cd design-tokens && npm run build"
                exit 1
            }
        fi
    fi
else
    echo "No build system found. Skipping pre-push tests."
fi
