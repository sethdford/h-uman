<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase G4 (2026-05-18) — autonomous M3 personalization loop.

  Runs scripts/m3_loop_cycle.sh on a weekly schedule. The script
  itself is the orchestrator (poll → export → train → eval → drift);
  this plist just owns the schedule + logs.

  Install:
    cp scripts/ai.human.m3-loop.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.human.m3-loop.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.human.m3-loop.plist
    rm ~/Library/LaunchAgents/ai.human.m3-loop.plist

  Adjust schedule (default: Sundays 4:00 AM local) by editing
  StartCalendarInterval below.

  M3_AUTO_PROMOTE: 2026-05-19 flipped from 0 → 1 after the dual-gate
  (metadata + behavioral with diversity check) shipped and was proven
  to block mode-collapsed adapters. Auto-promote fires ONLY when BOTH
  gates pass; the behavioral eval's diversity guard blocks structurally
  Seth-like but contextually-broken adapters automatically.
-->

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.human.m3-loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sethford/Projects/h-uman/scripts/m3_loop_cycle.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/sethford</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/sethford/.local/bin</string>
        <key>HUMAN_MLX_URL</key>
        <string>http://127.0.0.1:8741</string>
        <key>M3_DPO_THRESHOLD</key>
        <string>32</string>
        <!-- 1 = auto-promote on (PASS metadata + non-regress behavioral).
             Safe because the diversity guard blocks mode-collapse;
             see docs/research/2026-05-19-m3-autonomous-loop.md. -->
        <key>M3_AUTO_PROMOTE</key>
        <string>1</string>
        <!-- Training backend: local (default, Apple Silicon mlx_lm) or
             gce (provisions a GPU VM via scripts/m3_gce_train.sh).
             gce backend ALSO requires M3_GCE_CONFIRM_SPEND=1 — the
             plist won't accidentally spin up a billable VM. -->
        <key>M3_TRAINING_BACKEND</key>
        <string>local</string>
    </dict>

    <!-- Weekly: Sundays at 04:00 local time. Off-hours so a slow
         training run doesn't interfere with user-facing inference. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/sethford/.human/logs/m3-loop-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sethford/.human/logs/m3-loop-stderr.log</string>
</dict>
</plist>
