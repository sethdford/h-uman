<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Human</title>
    <background file="" alignment="topleft" scaling="none"/>
    <welcome language="en">Welcome to Human Installer</welcome>
    <domains enable_localSystem="true"/>
    <!-- CDATA so JavaScript comparisons never need XML escaping (an unescaped
         "<" here once made every productbuild fail). APIs per Apple's Installer
         JS: system.version is a dictionary (ProductVersion), and free space is
         my.target.availableKilobytes, which exists only in volume-check. -->
    <script><![CDATA[
        function check_system_requirements() {
            var version = system.version.ProductVersion;
            if (system.compareVersions(version, '10.15') < 0) {
                my.result.title = "OS Too Old";
                my.result.message = "macOS 10.15 (Catalina) or later is required";
                my.result.type = "Fatal";
                return false;
            }
            return true;
        }
        function check_disk_space() {
            var required_kb = 500 * 1024;
            if (my.target.availableKilobytes < required_kb) {
                my.result.title = "Not Enough Disk Space";
                my.result.message = "At least 500 MB free space is required";
                my.result.type = "Fatal";
                return false;
            }
            return true;
        }
    ]]></script>
    <installation-check script="check_system_requirements()"/>
    <volume-check script="check_disk_space()"/>
    <pkg-ref id="com.h-uman.human.pkg" version="@VERSION@" installKBytes="0">com.h-uman.human.pkg</pkg-ref>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.h-uman.human.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.h-uman.human.pkg" visible="false">
        <pkg-ref id="com.h-uman.human.pkg"/>
    </choice>
    <pkg-ref id="com.h-uman.human.pkg" onConclusion="none">com.h-uman.human.pkg</pkg-ref>
</installer-gui-script>
