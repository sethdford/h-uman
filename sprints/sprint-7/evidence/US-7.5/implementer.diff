+    HU_TEST_SUITE("w14_lora_retrain");
+    HU_RUN_TEST(test_retrain_enqueues_and_invokes_finetune);
+    HU_RUN_TEST(test_retrain_promotes_on_pass_skips_on_fail);
+    HU_RUN_TEST(test_retrain_treats_judgment_skip_as_not_pass);
