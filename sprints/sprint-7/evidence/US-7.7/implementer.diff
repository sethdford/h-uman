+    hu_provider_t prov = {.ctx = NULL, .vtable = &MOCK_VTABLE_LLAMACPP};
+    hu_communication_style_t empty = build_empty_style();
+    hu_chat_request_t req = build_minimal_request();
+
+    hu_best_of_n_stats_t stats;
